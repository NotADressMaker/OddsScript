# Track bias detection
print("\n\n=== TRACK BIAS ANALYSIS ===")

# Speed bias
let fr_wins = 35
let fr_starters = 90
let closer_wins = 12
let closer_starters = 90

let speed_bias = speed_bias_score(fr_wins, fr_starters, closer_wins, closer_starters)
print("Front-runner Win%: " + (fr_wins / fr_starters * 100) + "%")
print("Closer Win%: " + (closer_wins / closer_starters * 100) + "%")
print("Speed Bias Score: " + speed_bias + "%")

if speed_bias > 10 {
    print("✓✓ STRONG SPEED BIAS TODAY")
    print("  Action: Favor horses with early speed")
}

# Rail bias
let rail_wins = 18
let rail_runners = 90
let middle_wins = 22
let middle_runners = 90
let outside_wins = 12
let outside_runners = 90

let rail_bias_result = rail_bias(rail_wins, rail_runners,
                                  middle_wins, middle_runners,
                                  outside_wins, outside_runners)

print("\n--- Post Position Bias ---")
print("Rail (1-3): " + (rail_wins / rail_runners * 100) + "%")
print("Middle (4-6): " + (middle_wins / middle_runners * 100) + "%")
print("Outside (7+): " + (outside_wins / outside_runners * 100) + "%")
print("Bias: " + rail_bias_result)

if rail_bias_result == "inside" {
    print("✓ INSIDE BIAS - favor low post positions")
}

