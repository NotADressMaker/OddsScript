# Monte Carlo simulation for betting strategy

print("=== Monte Carlo Bankroll Simulation ===")

let starting_bankroll = 1000
let num_simulations = 10
let bets_per_sim = 50

let win_probability = 0.54  # Slight edge
let line = -110
let bet_pct = 0.02  # 2% of bankroll

print("Starting bankroll:")
print(starting_bankroll)
print("Simulations:")
print(num_simulations)
print("Bets per simulation:")
print(bets_per_sim)
print("Win probability:")
print(win_probability * 100)

# Track results
let final_bankrolls = []
let busted_count = 0
let profitable_count = 0

# Run simulations
let sim = 0
while sim < num_simulations {
    let my_bankroll = starting_bankroll
    let bet_count = 0

    while bet_count < bets_per_sim {
        if my_bankroll < 1 {
            busted_count = busted_count + 1
            bet_count = bets_per_sim  # Exit loop
        } else {
            let bet_size = my_bankroll * bet_pct

            # Simulate random outcome (simplified)
            # In real code would use random number
            let random_val = (bet_count * sim) % 100
            let won = random_val < (win_probability * 100)

            if won {
                let profit = bet_size * (100 / 110)
                my_bankroll = my_bankroll + profit
            } else {
                my_bankroll = my_bankroll - bet_size
            }

            bet_count = bet_count + 1
        }
    }

    # Record result
    if my_bankroll > starting_bankroll {
        profitable_count = profitable_count + 1
    }

    print("Simulation result:")
    print(my_bankroll)

    sim = sim + 1
}

print("\n=== Summary ===")
print("Profitable simulations:")
print(profitable_count)
print("Busted simulations:")
print(busted_count)
print("Success rate %:")
print((profitable_count / num_simulations) * 100)
