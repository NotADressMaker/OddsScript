}

let result = basketball_totals.compute(game, home_stats, away_stats, market, home_players, away_players)

print("Projected total:")
print(result.projected_total)
print("Total sigma:")
print(result.total_sigma)
print("Edge points:")
print(result.edge_points)
print("Prob over line:")
print(result.prob_over)
print("Prob under line:")
print(result.prob_under)
print("Recommendation:")
print(result.recommendation)
print("Derivative:")
print(result.derivative_recommendation)
print("Tags:")
print(result.tags)

let edge_threshold = 2.0
if result.edge_points >= edge_threshold and result.prob_over >= 0.55 {
    let odds_dec = result.chosen_odds_dec
    let odds = decimal_to_american(odds_dec)
    bet total "LAL vs BOS over" odds odds stake 110 spread result.chosen_line
}

if result.edge_points <= -edge_threshold and result.prob_under >= 0.55 {
    let odds_dec = result.chosen_odds_dec
    let odds = decimal_to_american(odds_dec)
    bet total "LAL vs BOS under" odds odds stake 110 spread result.chosen_line
}

if result.recommendation == "DERIVATIVE" {
    print("Derivative suggestion:")
    print(result.derivative_recommendation)
}
