# Export a bet slip to CSV and JSON

print("=== Bet Slip Exports ===")

let bets = [{"market": "NBA total over 228.5", "book": "Circa", "odds": -105, "stake": 50}, {"market": "NFL spread -3.5", "book": "DraftKings", "odds": -110, "stake": 40}, {"market": "Player points over 27.5", "book": "FanDuel", "odds": 125, "stake": 30}]

let total_stake = 0
let i = 0
while i < len(bets) {
    total_stake = total_stake + bets[i]["stake"]
    i = i + 1
}

let slip = {"bets": bets, "total_stake": total_stake}

print("=== CSV Bet Slip ===")
print(to_csv(bets))
print("=== JSON Bet Slip ===")
print(to_json(slip))
