# Multi-market ratings model example (NHL)

import multi_market_ratings

print("=== NHL Multi-Market Ratings Example ===")

let games = [
    {"sport": "NHL", "home_team": "Bruins", "away_team": "Rangers", "home_score": 3, "away_score": 2},
    {"sport": "NHL", "home_team": "Avalanche", "away_team": "Stars", "home_score": 4, "away_score": 3},
    {"sport": "NHL", "home_team": "Oilers", "away_team": "Canucks", "home_score": 2, "away_score": 5},
    {"sport": "NHL", "home_team": "Lightning", "away_team": "Panthers", "home_score": 4, "away_score": 2},
    {"sport": "NHL", "home_team": "Maple Leafs", "away_team": "Sabres", "home_score": 3, "away_score": 4},
    {"sport": "NHL", "home_team": "Rangers", "away_team": "Bruins", "home_score": 1, "away_score": 2},
    {"sport": "NHL", "home_team": "Stars", "away_team": "Oilers", "home_score": 5, "away_score": 4},
    {"sport": "NHL", "home_team": "Canucks", "away_team": "Avalanche", "home_score": 2, "away_score": 3},
    {"sport": "NHL", "home_team": "Panthers", "away_team": "Maple Leafs", "home_score": 4, "away_score": 3},
    {"sport": "NHL", "home_team": "Sabres", "away_team": "Lightning", "home_score": 2, "away_score": 3}
]

let model = multi_market_ratings.init("NHL")

for g in games {
    multi_market_ratings.update(model, g)
}

let matchups = [
    {"home_team": "Bruins", "away_team": "Lightning", "spread_line": -0.5, "total_line": 6.0, "label": "Bruins vs Lightning"},
    {"home_team": "Avalanche", "away_team": "Oilers", "spread_line": -0.5, "total_line": 6.5, "label": "Avalanche vs Oilers"}
]

for game in matchups {
    let pred_spread = multi_market_ratings.predict_spread(model, game.home_team, game.away_team)
    let pred_total = multi_market_ratings.predict_total(model, game.home_team, game.away_team)
    let pcover = multi_market_ratings.prob_cover(model, game.home_team, game.away_team, game.spread_line)
    let pover = multi_market_ratings.prob_over(model, game.home_team, game.away_team, game.total_line)

    print(game.label + " predicted spread: " + pred_spread)
    print(game.label + " predicted total: " + pred_total)
    print("Cover prob: " + pcover)
    print("Over prob: " + pover)

    let spread_edge = pred_spread - game.spread_line
    let total_edge = pred_total - game.total_line

    if pcover >= 0.55 and abs(spread_edge) >= 0.4 {
        bet spread ("Home " + game.label) odds -110 stake 50
    }

    if pover >= 0.55 and abs(total_edge) >= 0.4 {
        bet total ("Over " + game.label) odds -110 stake 50
    }
}
