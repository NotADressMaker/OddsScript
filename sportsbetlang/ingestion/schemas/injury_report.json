{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InjuryReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "player",
    "team",
    "league",
    "status",
    "injury_type",
    "body_part",
    "minutes_restriction",
    "source",
    "observed_at",
    "effective_date",
    "confidence"
  ],
  "properties": {
    "player": {"type": ["string", "null"]},
    "team": {"type": ["string", "null"]},
    "league": {"type": ["string", "null"]},
    "status": {
      "type": ["string", "null"],
      "enum": [
        "out",
        "doubtful",
        "questionable",
        "limited",
        "active",
        null
      ]
    },
    "injury_type": {"type": ["string", "null"]},
    "body_part": {"type": ["string", "null"]},
    "minutes_restriction": {"type": ["string", "null"]},
    "source": {"type": "string"},
    "observed_at": {"type": "string"},
    "effective_date": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "raw_text": {"type": ["string", "null"]}
  }
}
