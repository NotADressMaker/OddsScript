# SportsBetLang API - Production Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=4

# Database
DATABASE_PATH=/app/data/betting.db

# CORS Origins (comma-separated)
# Replace with your actual frontend domains
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Security
API_SECRET_KEY=your-secret-key-here-change-this
ENABLE_API_AUTH=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/sportsbetlang/api.log

# Optional: Redis for caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional: PostgreSQL (instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/sportsbetlang

# Optional: Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Optional: Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
