# OddsScript Configuration File
# Copy this file to .env and customize for your environment

# ===== Kelly Criterion Settings =====
# Fraction of full Kelly to bet (0.25 = quarter Kelly, recommended)
ODDSSCRIPT_KELLY_FRACTION=0.25

# Maximum percentage of bankroll to bet on single wager
ODDSSCRIPT_MAX_KELLY_PCT=0.10

# ===== Elo Rating Settings =====
# K-factor determines how quickly ratings change (higher = more volatile)
ODDSSCRIPT_ELO_K_FACTOR=32

# Home field advantage in Elo points
ODDSSCRIPT_ELO_HOME_ADVANTAGE=100

# ===== Sharp Money Detection =====
# Minimum threshold for reverse line movement (0.5 = half point)
ODDSSCRIPT_SHARP_RLM_THRESHOLD=0.5

# Line velocity threshold for steam moves (points per hour)
ODDSSCRIPT_SHARP_VELOCITY_THRESHOLD=2.0

# Minimum difference between bet% and money% to flag sharp action
ODDSSCRIPT_SHARP_BET_MONEY_DIFF=10.0

# ===== Public Fade Settings =====
# Minimum public percentage to consider fading
ODDSSCRIPT_PUBLIC_FADE_MIN_PCT=70

# Bonus edge for primetime games (public betting is worse)
ODDSSCRIPT_PUBLIC_FADE_PRIMETIME_BONUS=0.02

# ===== Arbitrage Settings =====
# Minimum profit percentage to flag arbitrage opportunity
ODDSSCRIPT_ARB_MIN_PROFIT=0.5

# Maximum hold percentage for valid market
ODDSSCRIPT_ARB_MAX_HOLD=110

# ===== Parlay Settings =====
# Maximum number of legs in optimized parlays
ODDSSCRIPT_PARLAY_MAX_LEGS=4

# Maximum correlation coefficient between parlay legs
ODDSSCRIPT_PARLAY_MAX_CORRELATION=0.3

# ===== Display Settings =====
# Default odds format: american, decimal, or fractional
ODDSSCRIPT_DEFAULT_ODDS_FORMAT=american

# Number of decimal places to display
ODDSSCRIPT_DECIMAL_PLACES=2

# ===== Data Storage =====
# Storage backend: csv or sqlite
ODDSSCRIPT_STORAGE_BACKEND=csv

# Directory for data files (~ expands to home directory)
ODDSSCRIPT_DATA_DIR=~/.oddsscript/data

# SQLite database filename (only used if STORAGE_BACKEND=sqlite)
ODDSSCRIPT_DB_FILENAME=oddsscript.db

# ===== Caching =====
# Enable caching for expensive calculations
ODDSSCRIPT_ENABLE_CACHE=true

# Cache time-to-live in seconds
ODDSSCRIPT_CACHE_TTL=300

# Maximum number of cached items
ODDSSCRIPT_CACHE_MAX_SIZE=1000

# ===== Performance =====
# Enable multiprocessing for parallel calculations
ODDSSCRIPT_ENABLE_MULTIPROCESSING=true

# Maximum number of CPU cores to use
ODDSSCRIPT_MAX_WORKERS=4

# Minimum simulations before using parallel processing
ODDSSCRIPT_MONTE_CARLO_THRESHOLD=1000

# ===== Backtesting =====
# Starting bankroll for backtests
ODDSSCRIPT_BACKTEST_STARTING_BANKROLL=1000

# Default strategy for backtesting
ODDSSCRIPT_BACKTEST_DEFAULT_STRATEGY=kelly

# ===== Risk Management =====
# Maximum percentage of bankroll to risk per day
ODDSSCRIPT_MAX_DAILY_RISK=0.05

# Stop-loss threshold (stop betting if down this much)
ODDSSCRIPT_STOP_LOSS_PCT=0.20

# Minimum edge required to place a bet
ODDSSCRIPT_MIN_EDGE_THRESHOLD=0.02

# ===== API Settings =====
# Timeout for API requests (seconds)
ODDSSCRIPT_API_TIMEOUT=30

# Number of retry attempts for failed API calls
ODDSSCRIPT_API_RETRY_ATTEMPTS=3
